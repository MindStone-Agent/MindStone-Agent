{
  "name": "mindstone-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MindStone proper rebuild on a vendored current Pi base with isolated runtime state.",
  "scripts": {
    "show:isolation": "./scripts/show-isolation.sh",
    "install:native": "./scripts/install-native.sh",
    "build:pi": "./scripts/build-pi-base.sh",
    "pi": "./scripts/pi-agent",
    "docker:build": "docker build -t mindstone-agent:local .",
    "docker:run": "docker run --rm -it -v mindstone-agent-pi-agent-state:/home/node/.pi/agent -v mindstone-agent-pi-session-state:/home/node/.pi-sessions -v mindstone-agent-runtime-state:/home/node/.mindstone-agent -p 19789:19789 mindstone-agent:local",
    "build:mindstone": "tsc -b packages/mindstone-core packages/mindstone-gateway packages/mindstone-pi-adapter",
    "dev:gateway": "./scripts/dev-gateway.sh",
    "start:gateway": "./scripts/start-gateway.sh",
    "smoke:native": "./scripts/smoke-native.sh",
    "smoke:docker": "./scripts/smoke-docker.sh",
    "init:runtime": "./scripts/init-runtime.sh",
    "smoke:auth": "./scripts/smoke-gateway-auth.sh",
    "smoke:openai": "./scripts/smoke-openai.sh",
    "smoke:transcripts": "./scripts/smoke-transcripts.sh",
    "smoke:chat": "./scripts/smoke-chat-history.sh",
    "smoke:rpc": "./scripts/smoke-rpc.sh",
    "smoke:ws-rpc": "./scripts/smoke-ws-rpc.sh",
    "smoke:context-window": "./scripts/smoke-context-window.sh",
    "smoke:sliding-window": "./scripts/smoke-sliding-window.sh"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3"
  }
}
