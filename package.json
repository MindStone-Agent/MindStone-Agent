    "smoke:channel-catalog": "./scripts/smoke-channel-catalog.sh",
    "smoke:pi-provider-config": "./scripts/smoke-pi-provider-config.sh",
    "smoke:config-wizard": "./scripts/smoke-config-wizard.sh",
