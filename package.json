{
  "name": "mindstone-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MindStone proper rebuild on a vendored current Pi base with isolated runtime state.",
  "bin": {
    "mindstone": "packages/mindstone-cli/bin/mindstone.js"
  },
  "scripts": {
    "show:isolation": "./scripts/show-isolation.sh",
    "install:native": "./scripts/install-native.sh",
    "link:cli": "./scripts/link-cli.sh",
    "build:pi": "./scripts/build-pi-base.sh",
    "pi": "./scripts/pi-agent",
    "docker:build": "docker build -t mindstone-agent:local .",
    "docker:run": "docker run --rm -it -v mindstone-agent-pi-agent-state:/home/node/.pi/agent -v mindstone-agent-pi-session-state:/home/node/.pi-sessions -v mindstone-agent-runtime-state:/home/node/.mindstone-agent -p 19789:19789 mindstone-agent:local",
    "build:mindstone": "tsc -b packages/mindstone-core packages/mindstone-gateway packages/mindstone-pi-adapter packages/mindstone-cli",
    "dev:gateway": "./scripts/dev-gateway.sh",
    "start:gateway": "./scripts/start-gateway.sh",
    "mindstone": "./scripts/mindstone",
    "smoke:native": "./scripts/smoke-native.sh",
    "smoke:cli-bin": "./scripts/smoke-cli-bin.sh",
    "smoke:install-script": "./scripts/smoke-install-script.sh",
    "smoke:mvp-native": "./scripts/smoke-mvp-native.sh",
