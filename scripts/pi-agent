#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/env.sh"

PI_CLI="${MINDSTONE_AGENT_ROOT}/vendor/pi/packages/coding-agent/dist/cli.js"
if [[ ! -f "${PI_CLI}" ]]; then
  echo "MindStone-Agent Pi base is not built yet." >&2
  echo "Run: ./scripts/install-native.sh" >&2
  exit 1
fi

exec node "${PI_CLI}" "$@"
